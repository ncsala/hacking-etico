# Reglas propias del lab (lado azul)
# 1) Portscan: 20+ SYNs a puertos distintos en 60s desde una misma IP
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB Portscan 20puertos/60s"; flags:S; detection_filter: track by_src, count 20, seconds 60; sid:1000001; rev:2;)
# 2) User-Agent de sqlmap en HTTP
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB UA sqlmap"; http.user_agent; content:"sqlmap"; nocase; sid:1000002; rev:1;)
# 3) Bruteforce SSH: 5+ SYNs nuevos al 22 en 60s
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"LAB SSH 5conn/60s"; flags:S; detection_filter: track by_src, count 5, seconds 60; sid:1000003; rev:1;)
